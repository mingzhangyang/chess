{
  "name": "chess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "worker:dev": "wrangler dev --env dev",
    "worker:dev:build": "npm run build && wrangler dev --env dev",
    "worker:typegen": "wrangler types --include-runtime=false",
    "worker:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-chessboard": "^5.10.0",
    "react-dom": "^19.0.0",
    "stockfish.wasm": "^0.10.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.50.0"
  }
}
