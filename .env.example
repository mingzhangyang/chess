# Browser configuration only. Never put long-lived API keys or other secrets in
# VITE_* variables because Vite bundles them into public assets. TURN
# credentials are also public to browser users; use short-lived, scoped values.

# Optional realtime socket base URL. If set, client connects to:
#   <VITE_REALTIME_WS_URL>/<ROOM_ID>
# Example: wss://realtime.example.com/ws
#VITE_REALTIME_WS_URL="wss://your-domain.example/ws"

# Optional comma-separated websocket paths for same-origin fallback.
# Default: /ws,/api/ws
#VITE_REALTIME_WS_PATHS="/ws,/api/ws"

# Max reconnect attempts before surfacing a hard-unavailable state.
# Default: 8
#VITE_REALTIME_MAX_RECONNECT_ATTEMPTS="8"

# Optional ICE server override in JSON array format. Include TURN for reliability.
# Example:
#VITE_RTC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:turn.example.com:3478?transport=udp"],"username":"user","credential":"pass"}]'

# Cloudflare Worker variable: comma-separated browser origins allowed to open
# room WebSockets. Configure this in Wrangler/dashboard, not as a VITE_* value.
#ALLOWED_ORIGINS="https://chess.example"
